{
  "name": "claude-code-visual-manager",
  "version": "9.0.0",
  "private": true,
  "scripts": {
    "start": "npm run build --prefix client && node server/index.js",
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "test": "npm test --prefix server",
    "debug:swarm:codex-handoff": "node scripts/swarm-codex-handoff-e2e.mjs",
    "debug:swarm:codex-handoff:prepare": "node scripts/swarm-codex-handoff-e2e.mjs --prepare-only",
    "debug:swarm:codex-handoff:reuse": "node scripts/swarm-codex-handoff-e2e.mjs --reuse-server",
    "test:visual:swarm": "node scripts/swarm-visual-regression.mjs",
    "test:visual:swarm:update": "node scripts/swarm-visual-regression.mjs --update",
    "test:visual:swarm:prepare": "node scripts/swarm-visual-regression.mjs --prepare-only",
    "test:visual:swarm:reuse": "node scripts/swarm-visual-regression.mjs --reuse-server",
    "test:playwright:v17-review-followup": "node scripts/v17-review-followup-playwright-smoke.mjs",
    "check:server-freshness": "node scripts/check-server-freshness.mjs",
    "check:server-freshness:warn": "node scripts/check-server-freshness.mjs --warn-only"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  },
  "dependencies": {
    "@google/stitch-sdk": "^0.0.3",
    "playwright-core": "^1.59.1"
  },
  "description": "Claude Code Visual Manager v9.0.0 - graphical UI for Claude Code CLI with live terminal, job runner, hybrid stream-json/PTy swarm runtime, and N8N-style workflow editor.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
